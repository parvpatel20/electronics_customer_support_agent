# Local dev
# VITE_API_BASE=http://localhost:8000

# Production (Railway backend) — used when you build for deployment
# VITE_API_BASE=https://electronics-customer-support-agent.onrender.com

# Per-environment files override these:
#   .env.development → loaded by `vite` (dev server)
#   .env.production  → loaded by `vite build`
# If neither file is present, the frontend falls back to http://localhost:8000.
